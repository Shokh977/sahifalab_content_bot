# Telegram bot token from @BotFather
BOT_TOKEN=

# Numeric channel ID (e.g. -1001234567890) — bot must be an admin of this channel
# with "Post Messages" permission
CHANNEL_ID=

# Comma-separated Telegram user IDs allowed to run admin commands / approve drafts
ADMIN_TELEGRAM_IDS=

# Same Supabase Postgres the FastAPI backend (Telegram App/backend) uses —
# copy the value from that project's DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Google Gemini API key (Google AI Studio) — can reuse the same key as
# Telegram App/backend's GEMINI_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Content language script for generated posts: "latin" or "cyrillic"
SCRIPT=latin

# IANA timezone used for scheduling and the posting windows below
TIMEZONE=Asia/Tashkent

# Comma-separated HH:MM local times (in TIMEZONE) when the posting-window job fires
POSTING_WINDOWS=09:00,19:00

# How often (hours) the RSS/YouTube ingest+draft job runs
FETCH_INTERVAL_HOURS=4

# Minimum relevance score (0-1) for an ingested item to get drafted
RELEVANCE_THRESHOLD=0.15

# Minimum hours between two opportunistic quote drafts
QUOTE_DRAFT_COOLDOWN_HOURS=20

# UTM tagging for CTA links appended to posts (click tracking without a shortener)
UTM_BASE_URL=https://sahifalab.uz
UTM_SOURCE=telegram
UTM_MEDIUM=channel_post

# Redis URL for FSM state storage (optional — falls back to in-memory if unset/unreachable)
REDIS_URL=redis://localhost:6379/0
